{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PrestaTec: ejecutar pruebas",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest -v",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "PrestaTec: iniciar servidor",
      "type": "shell",
      "command": "${command:python.interpreterPath} run.py",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "PrestaTec: migrar data.json a SQLite",
      "type": "shell",
      "command": "${command:python.interpreterPath} migrar.py",
      "problemMatcher": []
    },
    {
      "label": "PrestaTec: crear respaldo verificable",
      "type": "shell",
      "command": "${command:python.interpreterPath} respaldar.py crear data.json",
      "problemMatcher": []
    }
  ]
}
